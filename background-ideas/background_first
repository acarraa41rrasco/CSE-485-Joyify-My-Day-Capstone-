/*
 * joy-background.js — thought-map + mood-shift canvas background.
 *
 * Usage:
 *   <canvas id="bg" aria-hidden="true" style="position:fixed;inset:0;width:100%;height:100%"></canvas>
 *   <script src="joy-background.js"></script>
 *   <script>
 *     const bg = JoyBackground.init(document.getElementById("bg"));
 *     bg.setWarmth(0.4);                    // 0 = heavy/stormy ... 1 = bright
 *     bg.addThought("back-to-back meetings");           // labelled node
 *     bg.addThought("coffee that was hot", true);       // glowing "joy" node
 *     bg.clearThoughts();
 *   </script>
 *
 * Returns: { setWarmth, getWarmth, addThought, clearThoughts, setReducedMotion, destroy }
 * Respects prefers-reduced-motion by default.
 */
(function (global) {
  "use strict";

  // Palette stops, from warmth 0 -> 1
  var STOPS = [
    { bg: ["#2b3350", "#3d4766"], blobs: ["#56648f", "#6b5b8a", "#44587a"], node: [196, 206, 235] },
    { bg: ["#5d5a8c", "#9a86b8"], blobs: ["#b79ad0", "#d99fb8", "#8fa0d6"], node: [226, 220, 245] },
    { bg: ["#ffe3c4", "#ffd1c9"], blobs: ["#ffc79a", "#ffe59a", "#f6b5c8"], node: [255, 246, 232] },
    { bg: ["#fff4d6", "#e6f4e1"], blobs: ["#ffd98a", "#bfe6c8", "#ffcfa8"], node: [255, 252, 238] }
  ];

  function hex(h) { return [parseInt(h.slice(1, 3), 16), parseInt(h.slice(3, 5), 16), parseInt(h.slice(5, 7), 16)]; }
  function mix(a, b, t) { return [a[0] + (b[0] - a[0]) * t, a[1] + (b[1] - a[1]) * t, a[2] + (b[2] - a[2]) * t]; }
  function rgba(c, a) { return "rgba(" + (c[0] | 0) + "," + (c[1] | 0) + "," + (c[2] | 0) + "," + a + ")"; }
  function rand(a, b) { return a + Math.random() * (b - a); }

  STOPS.forEach(function (s) { s.bgRGB = s.bg.map(hex); s.blobRGB = s.blobs.map(hex); });

  function palette(w) {
    var f = w * (STOPS.length - 1), i = Math.min(STOPS.length - 2, Math.floor(f)), t = f - i;
    var A = STOPS[i], B = STOPS[i + 1];
    return {
      bg: [mix(A.bgRGB[0], B.bgRGB[0], t), mix(A.bgRGB[1], B.bgRGB[1], t)],
      blobs: [0, 1, 2].map(function (k) { return mix(A.blobRGB[k], B.blobRGB[k], t); }),
      node: mix(A.node, B.node, t)
    };
  }

  function init(canvas, options) {
    options = options || {};
    var ctx = canvas.getContext("2d");
    var mq = global.matchMedia("(prefers-reduced-motion: reduce)");
    var reduced = options.reducedMotion != null ? options.reducedMotion : mq.matches;
    var W = 0, H = 0, DPR = 1;
    var target = 0, warmth = 0, nodes = [], mouse = { x: -9999, y: -9999 };
    var dirty = true, lastT = 0, raf = 0, alive = true;

    function makeNode(o) {
      var ang = Math.random() * Math.PI * 2, v = rand(0.1, 0.32), sp = reduced ? 0 : 1;
      return {
        x: o.x, y: o.y, bx: Math.cos(ang) * v * sp, by: Math.sin(ang) * v * sp, ix: 0, iy: 0,
        r: o.r || rand(1.6, 3.2), label: o.label || null, joy: !!o.joy,
        born: o.label ? performance.now() : -1e9
      };
    }
    function seedAmbient() {
      nodes = nodes.filter(function (n) { return n.label; });
      var n = Math.max(18, Math.min(46, Math.round(W * H / 26000)));
      for (var i = 0; i < n; i++) nodes.push(makeNode({ x: rand(0, W), y: rand(0, H) }));
    }
    function resize() {
      DPR = Math.min(global.devicePixelRatio || 1, 2);
      W = global.innerWidth; H = global.innerHeight;
      canvas.width = W * DPR; canvas.height = H * DPR;
      ctx.setTransform(DPR, 0, 0, DPR, 0, 0);
      seedAmbient(); dirty = true;
    }

    function roundRect(x, y, w, h, r) {
      ctx.beginPath(); ctx.moveTo(x + r, y);
      ctx.arcTo(x + w, y, x + w, y + h, r); ctx.arcTo(x + w, y + h, x, y + h, r);
      ctx.arcTo(x, y + h, x, y, r); ctx.arcTo(x, y, x + w, y, r); ctx.closePath();
    }

    function update(dt) {
      warmth = reduced ? target : warmth + (target - warmth) * Math.min(1, dt * 0.0022);
      if (Math.abs(target - warmth) < 0.0005) warmth = target;
      if (reduced) return;
      for (var i = 0; i < nodes.length; i++) {
        var n = nodes[i], dx = mouse.x - n.x, dy = mouse.y - n.y, d = Math.sqrt(dx * dx + dy * dy);
        if (d < 170 && d > 1) { var f = (1 - d / 170) * 0.012; n.ix += (dx / d) * f * dt; n.iy += (dy / d) * f * dt; }
        n.ix *= 0.95; n.iy *= 0.95;
        n.x += (n.bx + n.ix) * dt * 0.06; n.y += (n.by + n.iy) * dt * 0.06;
        if (n.x < -20) n.x = W + 20; else if (n.x > W + 20) n.x = -20;
        if (n.y < -20) n.y = H + 20; else if (n.y > H + 20) n.y = -20;
      }
    }

    function draw(t) {
      var P = palette(warmth), i, j, a, b;

      // base gradient
      var g = ctx.createLinearGradient(0, 0, 0, H);
      g.addColorStop(0, rgba(P.bg[0], 1)); g.addColorStop(1, rgba(P.bg[1], 1));
      ctx.fillStyle = g; ctx.fillRect(0, 0, W, H);

      // drifting colour blobs
      var R = Math.max(W, H) * 0.55, tt = reduced ? 0 : t;
      for (var k = 0; k < 3; k++) {
        var cx = W * (0.5 + 0.38 * Math.sin(tt * 0.00006 * (k + 1) + k * 2.1));
        var cy = H * (0.5 + 0.34 * Math.cos(tt * 0.00005 * (k + 1.4) + k * 1.3));
        var rg = ctx.createRadialGradient(cx, cy, 0, cx, cy, R);
        rg.addColorStop(0, rgba(P.blobs[k], 0.55)); rg.addColorStop(1, rgba(P.blobs[k], 0));
        ctx.fillStyle = rg; ctx.fillRect(0, 0, W, H);
      }

      // links
      var LINK = 150; ctx.lineWidth = 1;
      for (i = 0; i < nodes.length; i++) {
        a = nodes[i];
        for (j = i + 1; j < nodes.length; j++) {
          b = nodes[j];
          var dx = a.x - b.x, dy = a.y - b.y, d2 = dx * dx + dy * dy;
          if (d2 < LINK * LINK) {
            ctx.strokeStyle = rgba(P.node, (1 - Math.sqrt(d2) / LINK) * (a.label || b.label ? 0.5 : 0.28));
            ctx.beginPath(); ctx.moveTo(a.x, a.y); ctx.lineTo(b.x, b.y); ctx.stroke();
          }
        }
        var mx = mouse.x - a.x, my = mouse.y - a.y, md = Math.sqrt(mx * mx + my * my);
        if (!reduced && md < 140) {
          ctx.strokeStyle = rgba(P.node, (1 - md / 140) * 0.55);
          ctx.beginPath(); ctx.moveTo(a.x, a.y); ctx.lineTo(mouse.x, mouse.y); ctx.stroke();
        }
      }

      // nodes + labels
      ctx.font = "500 13px Inter, system-ui, sans-serif"; ctx.textBaseline = "middle";
      var now = performance.now();
      for (i = 0; i < nodes.length; i++) {
        var n = nodes[i], grow = n.label ? Math.min(1, (now - n.born) / 700) : 1;
        grow = 1 - Math.pow(1 - grow, 3);
        var r = n.r * grow;
        if (n.joy) {
          var gl = ctx.createRadialGradient(n.x, n.y, 0, n.x, n.y, r * 5);
          gl.addColorStop(0, "rgba(255,214,102,.85)"); gl.addColorStop(1, "rgba(255,214,102,0)");
          ctx.fillStyle = gl; ctx.beginPath(); ctx.arc(n.x, n.y, r * 5, 0, 6.2832); ctx.fill();
          ctx.fillStyle = "#ffd666";
        } else {
          if (n.label) {
            var g2 = ctx.createRadialGradient(n.x, n.y, 0, n.x, n.y, r * 4);
            g2.addColorStop(0, rgba(P.node, 0.35 + 0.35 * warmth)); g2.addColorStop(1, rgba(P.node, 0));
            ctx.fillStyle = g2; ctx.beginPath(); ctx.arc(n.x, n.y, r * 4, 0, 6.2832); ctx.fill();
          }
          ctx.fillStyle = rgba(P.node, n.label ? 0.95 : 0.7);
        }
        ctx.beginPath(); ctx.arc(n.x, n.y, Math.max(0.1, r), 0, 6.2832); ctx.fill();

        if (n.label && grow > 0.6) {
          var txt = n.label.length > 28 ? n.label.slice(0, 27) + "…" : n.label;
          var tw = ctx.measureText(txt).width, px = 10, bx = n.x + 12, by = n.y - 12;
          if (bx + tw + px * 2 > W - 8) bx = n.x - 12 - tw - px * 2;
          ctx.globalAlpha = (grow - 0.6) / 0.4;
          ctx.fillStyle = "rgba(255,255,255,.88)"; roundRect(bx, by, tw + px * 2, 24, 12); ctx.fill();
          ctx.fillStyle = "#1f2438"; ctx.fillText(txt, bx + px, by + 12.5);
          ctx.globalAlpha = 1;
        }
      }
      if (options.onPalette) options.onPalette(P, warmth);
    }

    function frame(t) {
      if (!alive) return;
      var dt = Math.min(48, t - (lastT || t)); lastT = t;
      if (!reduced || dirty || Math.abs(target - warmth) > 0.0005) { update(dt || 16); draw(t); dirty = false; }
      raf = requestAnimationFrame(frame);
    }

    function onMove(e) { mouse.x = e.clientX; mouse.y = e.clientY; }
    function onLeave() { mouse.x = mouse.y = -9999; }
    global.addEventListener("pointermove", onMove);
    global.addEventListener("pointerleave", onLeave);
    global.addEventListener("resize", resize);
    resize(); raf = requestAnimationFrame(frame);

    return {
      setWarmth: function (v) { target = Math.max(0, Math.min(1, v)); dirty = true; },
      getWarmth: function () { return target; },
      addThought: function (text, joy) {
        var side = Math.random() < 0.5 ? -1 : 1;
        var x = W / 2 + side * rand(Math.min(300, W * 0.28), Math.min(520, W * 0.46));
        nodes.push(makeNode({ x: Math.max(70, Math.min(W - 70, x)), y: rand(H * 0.16, H * 0.84), r: joy ? 6 : 5, label: text, joy: joy }));
        var labelled = nodes.filter(function (n) { return n.label; });
        if (labelled.length > 14) nodes.splice(nodes.indexOf(labelled[0]), 1);
        dirty = true;
      },
      clearThoughts: function () { nodes = nodes.filter(function (n) { return !n.label; }); dirty = true; },
      setReducedMotion: function (on) {
        reduced = !!on;
        nodes.forEach(function (n) {
          var ang = Math.random() * Math.PI * 2, v = rand(0.1, 0.32), sp = reduced ? 0 : 1;
          n.bx = Math.cos(ang) * v * sp; n.by = Math.sin(ang) * v * sp; n.ix = n.iy = 0;
        });
        dirty = true;
      },
      destroy: function () {
        alive = false; cancelAnimationFrame(raf);
        global.removeEventListener("pointermove", onMove);
        global.removeEventListener("pointerleave", onLeave);
        global.removeEventListener("resize", resize);
      }
    };
  }

  global.JoyBackground = { init: init };
})(window);